    {
      "parameters": {
        "jsCode": "// Build the output columns, de-duplicated by ticket number.\n// UploadDate = the source dashboard date (same in every row) for the Power team's dashboard.\nconst source = $('Normalize upload').first().json;\nconst uploadDate = String(source.sourceDate || '');\nconst num = (v) => { const n = Number(String(v ?? '').trim()); return Number.isFinite(n) ? n : String(v ?? '').trim(); };\nconst seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const ticket = String(j.ticket ?? '').trim();\n  if (!ticket || seen.has(ticket)) continue;\n  seen.add(ticket);\n  out.push({ json: {\n    'UploadDate': uploadDate,\n    'Overdue Tickets': ticket,\n    'Ticket URL': String(j.url ?? '').trim(),\n    'Severity': String(j.severity ?? '').trim(),\n    'State': String(j.state ?? '').trim(),\n    'Status': String(j.sla ?? '').trim(),\n    'Assignment Group': String(j.group ?? '').trim(),\n    'Assignment': String(j.owner ?? '').trim(),\n    'Created': String(j.created ?? '').trim(),\n    'Days Actual': num(j.daysActual),\n    'SLA Days': num(j.slaDays),\n    'Days Over': num(j.daysOver),\n    'Summary': '',\n  }});\n}\n// Rows reached this node but none had a ticket link: the dashboard layout probably changed.\nif (out.length === 0) {\n  throw new Error(`No ticket rows found in \"${source.sourceFile}\". Has the dashboard HTML layout changed?`);\n}\nreturn out;"
      },

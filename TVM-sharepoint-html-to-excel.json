    {
      "parameters": {
        "jsCode": "// Expose the downloaded file as `data`, and read the date from its SharePoint filename.\nconst file = $('Loop over files').first().json;\nconst bin = $input.first().binary || {};\nconst key = Object.keys(bin)[0];\nif (!key) {\n  throw new Error(`SharePoint returned no content for \"${file.name}\".`);\n}\nconst name = String(file.name || bin[key].fileName || '');\nconst m = name.match(/(\\d{4}-\\d{2}-\\d{2})/);\n// No date in the name: use the day the file was last modified in SharePoint.\nconst modified = file.lastModifiedDateTime ? DateTime.fromISO(file.lastModifiedDateTime).toFormat('yyyy-MM-dd') : '';\nreturn [{ json: { sourceDate: m ? m[1] : modified, sourceFile: name }, binary: { data: bin[key] } }];"
      },
